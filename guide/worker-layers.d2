# Worker の中の JavaScript と Rust（Wasm）の関係。mise run guide が SVG にする（docs/development.md の「解説」）。
...@_style
# 線の文字を斜体にしない（_style.d2）。
(** -> **)[*].style.italic: false

# 解説の幅（628px）で横のスクロール無しに読めるよう、ランタイムの中を上から下へ縦に並べる。
# 線を水平と垂直だけにするため、グリッドで並べる（グリッドの中の線は、要素の中心どうしをまっすぐ結ぶ）。
# 左の列（使う人）・中の列（ランタイム）・右の列（Cloudflare のサービス）は同じ 5 段にし、
# 空いた段には見えない箱を置いて、段の高さをそろえる。3 つの枠の名前は、同じ 2 行にする（枠の中の始まりの高さをそろえる）。
# 矢印は呼ぶ向き。応答と呼んだ結果は、同じ線を逆にたどって戻る（本文に書く）。
grid-columns: 3
horizontal-gap: 70

users: 使う人\n（ブラウザ） {
  class: group
  grid-rows: 5
  vertical-gap: 50
  browser: ブラウザ\n（画面・API） {class: actor; width: 150; height: 100}
  s2: {style.opacity: 0; label: ""; width: 150; height: 100}
  s3: {style.opacity: 0; label: ""; width: 150; height: 100}
  s4: {style.opacity: 0; label: ""; width: 150; height: 100}
  browser_files: ブラウザ\n（CSS などの\nファイル） {class: actor; width: 150; height: 100}
}

runtime: Workers\nコードはランタイム（V8）の上で動く {
  class: [group; cloudflare]
  grid-rows: 5
  vertical-gap: 50
  entry: build/index.js\nfetch のハンドラー {class: actor; width: 290; height: 100}
  wasm: Rust を Wasm にしたもの\naxum・askama のテンプレート・\nmetadata.rs・workers-rs {class: app; width: 290; height: 100}
  glue: build/index.js\n橋渡しのコード・\nphoto-stream.js {class: actor; width: 290; height: 100}
  bindings: D1・R2 などの binding\n（JavaScript の値。\n通信はランタイムが行う） {class: service; width: 290; height: 100}
  assets: 静的アセット（public/）\nWorker も V8 も動かさずに返す {class: service; width: 290; height: 100}

  entry -> wasm: Rust を呼ぶ
  wasm -> glue: JavaScript を呼ぶ
  glue -> bindings: binding を呼ぶ
}

services: Cloudflare の\nサービス {
  class: group
  grid-rows: 5
  vertical-gap: 50
  s1: {style.opacity: 0; label: ""; width: 110; height: 100}
  s2: {style.opacity: 0; label: ""; width: 110; height: 100}
  s3: {style.opacity: 0; label: ""; width: 110; height: 100}
  stores: D1・R2 {class: store; width: 110; height: 100}
  s5: {style.opacity: 0; label: ""; width: 110; height: 100}
}

users.browser -> runtime.entry: リクエスト
runtime.bindings -> services.stores: 読み書き
users.browser_files -> runtime.assets: ファイル
