{
  "mcpServers": {
    "chrome-devtools": {
      "command": "pnpm",
      "args": [
        "exec",
        "chrome-devtools-mcp",
        "--isolated",
        "--no-usage-statistics",
        "--no-performance-crux"
      ],
      "env": {
        "CHROME_DEVTOOLS_MCP_NO_UPDATE_CHECKS": "1"
      }
    }
  }
}
